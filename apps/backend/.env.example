# App
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/barterdash

# Auth
JWT_SECRET=replace-with-at-least-32-characters
JWT_EXPIRES_IN=7d

# CORS (comma-separated origins; use * only if you intentionally allow all)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Stripe
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_IDENTITY_WEBHOOK_SECRET=whsec_your_identity_webhook_secret
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Redis
REDIS_URL=redis://localhost:6379

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_WEBHOOK_SECRET=replace-with-random-shared-secret

# Monitoring (optional)
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Security / Email (optional)
ENCRYPTION_KEY=your-encryption-key
RESEND_API_KEY=re_your_resend_key
FROM_EMAIL=no-reply@barterdash.com

# Stream Video (optional unless stream token endpoints are used)
STREAM_API_KEY=your-stream-api-key
STREAM_API_SECRET=your-stream-api-secret
STREAM_APP_ID=your-stream-app-id

# Frontend and Stripe Identity return links (optional)
# FRONTEND_URL must be an absolute http(s) URL for Stripe Checkout Session redirects.
FRONTEND_URL=https://barterdash.app
IDENTITY_RETURN_URL=barterdash://seller/verification
# Stripe Identity mode:
# - stripe: real Stripe Identity flow (production)
# - mock: TestFlight/dev flow, auto-approves after a short delay
IDENTITY_VERIFICATION_MODE=stripe
IDENTITY_MOCK_AUTO_APPROVE_DELAY_MS=1500
