# Public API base URL used by the mobile app
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api/v1

# Supabase (client-side/public values)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Stripe (client-side/public key)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
EXPO_PUBLIC_STRIPE_APPLE_PAY_MERCHANT_ID=merchant.com.barterdash.mobile
EXPO_PUBLIC_STRIPE_MERCHANT_COUNTRY_CODE=US
EXPO_PUBLIC_STRIPE_GOOGLE_PAY_TEST_ENV=true

# Stream Video (public key only; never put secret keys in mobile env)
EXPO_PUBLIC_STREAM_API_KEY=your-stream-api-key

# Optional local/dev test helpers used in stream flows
EXPO_PUBLIC_DEV_BUYER_ID=00000000-0000-0000-0000-000000000000
EXPO_PUBLIC_DEV_SELLER_ID=00000000-0000-0000-0000-000000000000

# Optional E2E test variables
E2E_TEST_EMAIL=test@example.com
E2E_TEST_PASSWORD=password123
E2E_SELLER_STREAM_ID=00000000-0000-0000-0000-000000000000
E2E_VIEWER_STREAM_ID=00000000-0000-0000-0000-000000000000
E2E_TEST_PRODUCT_ID=00000000-0000-0000-0000-000000000000
E2E_TEST_STREAM_ID=00000000-0000-0000-0000-000000000000
E2E_TEST_SELLER_ID=00000000-0000-0000-0000-000000000000

# Feature Flags
# Set to 'true' to enable Apple Pay (requires Apple Developer account + $99/year)
EXPO_PUBLIC_ENABLE_APPLE_PAY=false
# Set to 'false' to disable Google Pay
EXPO_PUBLIC_ENABLE_GOOGLE_PAY=true
# Show beta mode indicators in UI
EXPO_PUBLIC_BETA_MODE=true
